# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
*.tsbuildinfo

# Node
/node_modules
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Angular / build caches
/.angular/cache
.eslintcache
.stylelintcache
.parcel-cache
.cache/

# Environment & secrets — never commit these to a public repo
.env
.env.*
!.env.example
*.local
secrets.json
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# Deploy tooling
.netlify/
.vercel/
.firebase/
.wrangler/
.serverless/

# Tests & reports
/coverage
/.nyc_output
testem.log
/libpeerconnection.log
__screenshots__/
/playwright-report
/test-results
/blob-report
lighthouse-report*
*.lighthouseci
.lighthouseci/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.history/*
*.swp
*.swo
*~

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Claude Code — share project config, keep machine-local settings out
.claude/settings.local.json
.claude/*.local.json

# System files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Misc
/connect.lock
/typings
.sass-cache/
*.log
